# SPA no Apache (cPanel).
#
# As rotas do React (/entrar, /painel, /recuperar) nao existem como ficheiros:
# sem isto o servidor devolve 404 e o portal so abre na raiz.
# /api nao se reescreve: e a API, servida por proxy no mesmo dominio para o
# cookie de refresh (path /api/auth) continuar na mesma origem.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api($|/) - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
