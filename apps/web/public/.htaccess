# SPA no Apache (cPanel / Hostinger).
# DirectoryIndex e obrigatorio neste vhost: sem ele a raiz da 404 mesmo
# com index.html no disco. O padrao e o mesmo da FarmApp.
# /api nao se reescreve: o proxy do mesmo dominio trata a API.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api($|/) - [L]
  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
