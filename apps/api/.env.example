NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Base de dados
# ---------------------------------------------------------------------------
# Producao e desenvolvimento normal: Supabase.
# Onde encontrar: painel do Supabase > Project Settings > Database > Connection string.
#
# Use a ligacao "Session pooler" (porta 5432) ou a ligacao directa. A "Transaction pooler"
# (porta 6543) tambem funciona, mas nao suporta instrucoes preparadas nem estado de sessao,
# por isso evite-a enquanto as migracoes do Drizzle correrem por aqui.
#
# Substitua [PASSWORD] pela palavra-passe da base de dados e [REF] pela referencia do projecto.
# Se a palavra-passe tiver caracteres especiais, codifique-os para URL (@ vira %40).
DATABASE_URL=

# Alternativa local, com `pnpm db:up` a subir o Postgres em Docker:
# DATABASE_URL=postgresql://nexora:nexora@localhost:5434/nexora_projectos

# ---------------------------------------------------------------------------
# Sessoes
# ---------------------------------------------------------------------------
# Minimo de 32 caracteres cada. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-em-producao-com-32-caracteres
JWT_REFRESH_SECRET=troque-tambem-este-segredo-em-producao-32-car
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DIAS=30

WEB_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Email (convites e alertas de prazo)
# ---------------------------------------------------------------------------
# Sem SMTP configurado, as mensagens sao escritas no log em vez de enviadas,
# e a ligacao do convite aparece na consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NEXORA Projectos <nao-responder@nexora.co.mz>
